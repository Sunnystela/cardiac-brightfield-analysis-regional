<?xml version="1.0" encoding="utf-8"?>
<!-- Visual Studio Python project (Python development workload). Open this file in Visual Studio 2022;
     see docs/VISUAL_STUDIO_START.md. Not tested on Windows yet (prepared on Linux/WSL). -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{3B6C2E3A-7F1D-4C55-9C2B-6A1E8D0F4B21}</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>launch.py</StartupFile>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>Cardiac_Brightfield_Standalone</Name>
    <RootNamespace>Cardiac_Brightfield_Standalone</RootNamespace>
    <!-- empty = interactive menu; e.g. "info" or "morphology -h" -->
    <CommandLineArguments></CommandLineArguments>
    <!-- UTF-8 mode: the engine writes JSON with ensure_ascii=False using the default encoding -->
    <Environment>PYTHONUTF8=1</Environment>
    <InterpreterId>MSBuild|.venv|$(MSBuildProjectFullPath)</InterpreterId>
    <IsWindowsApplication>False</IsWindowsApplication>
    <TestFramework>Pytest</TestFramework>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="launch.py" />
    <Compile Include="adapters\**\*.py" />
    <Compile Include="tests\**\*.py" />
    <Compile Include="validation\**\*.py" />
    <Compile Include="tools\**\*.py" />
    <Compile Include="src\**\*.py" />
    <Compile Include="engine_scripts\**\*.py" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="configs\**\*" />
    <Content Include="docs\**\*" />
    <Content Include="README.md" />
    <Content Include="pyproject.toml" />
    <Content Include="requirements.txt" />
  </ItemGroup>
  <ItemGroup>
    <Interpreter Include=".venv\">
      <Id>.venv</Id>
      <Version>3.11</Version>
      <Description>.venv (Python 3.11 (64-bit))</Description>
      <InterpreterPath>Scripts\python.exe</InterpreterPath>
      <WindowsInterpreterPath>Scripts\pythonw.exe</WindowsInterpreterPath>
      <PathEnvironmentVariable>PYTHONPATH</PathEnvironmentVariable>
      <Architecture>X64</Architecture>
    </Interpreter>
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
</Project>
